# ===========================================================
# FlowerUI 运行时配置（.env 格式）
# -----------------------------------------------------------
# 规则：
#   * 每行 KEY=VALUE；系统保存时只更新对应行，不覆盖你的注释/手工键
#   * 列表/字典以 JSON 书写：cors_origins=["http://127.0.0.1:5556"]
#   * 字典示例：task_routes={"tasks.send_email": "emails"}
#   * 字符串含空格请用引号：db="flower state.db"
#   * 修改后需重启的配置，在界面点「重启系统」即可生效
# ===========================================================

# ---- 服务（HTTP 服务监听与跨域） ----
# 监听地址：HTTP 服务绑定的网卡地址  [类型=string; 需重启=是]
host="0.0.0.0"
# 监听端口：HTTP 服务端口  [类型=int; 需重启=是]
port=5555
# URL 前缀：反向代理下的子路径  [类型=string; 需重启=是]
url_prefix=""
# CORS 白名单：允许跨域的来源  [类型=list; 需重启=是]
cors_origins=["*"]
# 调试日志：打开后输出 DEBUG 级别日志  [类型=bool]
debug=false

# ---- Celery 连接（消息中间件连接与控制超时） ----
# Broker URL：消息中间件地址。本地务必用 127.0.0.1 而非 localhost，否则 IPv6 回退会给每次连接额外增加约 2 秒  [类型=string; 需重启=是; 密文=是; 界面只读=是]
broker_url="redis://127.0.0.1:6379/0"
# inspect 超时：向 worker 广播 inspect 命令的等待时长，调大更稳、调小更跟手  [类型=float; 范围=200~60000; 单位=ms]
inspect_timeout=3000.0
# 控制命令超时：pool grow/shrink、add_consumer 等远程控制命令的回执等待时长  [类型=float; 范围=200~60000; 单位=ms]
control_timeout=5000.0
# 启用事件采集：关闭后不再消费 Celery 事件流  [类型=bool; 需重启=是]
enable_events=true

# ---- 任务路由（下发任务时的默认队列与任务→队列映射） ----
# 默认队列：任务未命中路由表时使用的队列  [类型=string]
task_default_queue="celery"
# 任务→队列映射：下发任务页据此自动预填队列，例如 tasks.send_email → emails  [类型=dict]
task_routes={}

# ---- 状态容量（内存中保留的 worker / 任务数量上限） ----
# Worker 上限：内存中保留的 worker 数量上限  [类型=int; 范围=1~100000]
max_workers=5000
# 任务上限：内存中保留的任务数量上限  [类型=int; 范围=100~5000000]
max_tasks=100000
# 离线清理：worker 离线超过该秒数后从列表移除，留空表示不清理  [类型=int; 范围=0~86400; 单位=s]
purge_offline_workers=null

# ---- 持久化（状态落盘） ----
# 启用持久化：重启后恢复状态  [类型=bool; 需重启=是]
persistent=false
# 状态文件：状态落盘路径  [类型=string; 需重启=是]
db="flower.state"
# 保存间隔：0 表示关闭定时保存  [类型=int; 范围=0~3600000; 单位=ms]
state_save_interval=0

# ---- 展示（列表列与时间显示） ----
# 自动刷新：列表页自动刷新  [类型=bool]
auto_refresh=true
# 自然时间：时间显示为『3 分钟前』而不是绝对时间  [类型=bool]
natural_time=false
# 任务列表列：逗号分隔，控制任务表格默认展示哪些列  [类型=string]
tasks_columns="name,uuid,state,args,kwargs,result,received,started,runtime,worker"

# ---- 界面与实时通道（主题默认值、数据通道与轮询间隔） ----
# 默认主题：新访客首次打开时的主题，auto 表示跟随操作系统  [类型=enum; 可选=auto/light/dark/tech-liquid/aurora]
ui_default_theme="auto"
# 数据通道：ws=WebSocket 实时推送；polling=HTTP 轮询，适合不支持 WS 的代理  [类型=enum; 可选=ws/polling]
ui_transport="ws"
# 轮询间隔：仅在轮询模式下生效，间隔越小越实时、请求也越多  [类型=int; 范围=1000~120000; 单位=ms]
ui_poll_interval=3000
# 侧边栏默认收起：新访客首次打开时导航是否处于收起状态  [类型=bool]
ui_sidebar_collapsed=false

# ---- 认证（登录凭据与令牌有效期） ----
# 登录凭据：user:pass 列表，配置后前端将强制走登录页；在界面改完点『重启系统』生效  [类型=list; 需重启=是; 密文=是]
# 逗号分隔格式：user1:pass1,user2:pass2
basic_auth=admin:admin
# 登录凭证管理：总开关：开启后界面展示并允许编辑各用户凭据（展开可改自己的账号密码）；关闭则隐藏凭据管理  [类型=bool]
basic_auth_enabled=true
# 邮箱白名单正则：  [类型=string; 需重启=是]
# ⚠ 待完善：OAuth 登录流程尚未接入，该白名单目前不生效
auth=""
# OAuth 提供方：  [类型=string; 需重启=是]
# ⚠ 待完善：OAuth 登录流程尚未接入，暂未对接任何第三方登录
auth_provider=""
# JWT 密钥：  [类型=string; 需重启=是; 密文=是; 界面只读=是]
# ⚠ 待完善：暂不支持界面设置；留空时每次启动自动生成随机密钥，重启后旧令牌失效
# secret_key=（留空则每次启动自动生成随机 JWT 密钥，推荐保持留空）
# 令牌有效期：登录令牌过期时间  [类型=int; 范围=5~525600; 单位=min]
token_expire_minutes=1440

# ---- 演示模式（无 broker 时的内置模拟集群） ----
# 强制演示模式：忽略真实 broker，使用内置模拟集群  [类型=bool; 需重启=是]
mock=true
# 模拟 worker 数：  [类型=int; 需重启=是]
mock_workers=4
# 模拟任务数：  [类型=int; 需重启=是]
mock_seed_tasks=260
