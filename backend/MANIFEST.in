include LICENSE
include README.md
include pyproject.toml
recursive-include flowerui/static *
recursive-include flowerui/themes *.css
exclude flowerui.runtime.toml
exclude flowerui.db
exclude flower.state*
prune logs
prune tests
global-exclude __pycache__/*
global-exclude *.py[cod]
global-exclude *.db
global-exclude *.log
