# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
coverage/
.htmlcov/

# 前端
node_modules/
dist/
dist_new/
dist_old_*/
_obsolete_dist_bak/
_obsolete_dist_new/
.vite/
*.log

# 状态与配置
.env
flower.state*
*.db
# 旧版 .env 运行时配置（已迁到 backend/flowerui.runtime.toml），保留忽略规则
# 防止历史脚本再次生成后误入库；代码仅在没有 TOML 时才回退读取它
flowerui.runtime.env
backend/flowerui.runtime.env

# broker 运行时数据
.data/

# 参考资料（flower 原始源码）
.reference/

# 编辑器
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Windows
*.lnk

# 测试文档（可选提交）
测试文档.md

# WorkBuddy 工具内部状态（非项目源码）
.workbuddy/

# 后端运行时产物（worker / supervisor / 后端 PID 与日志，非源码，且可能被 .venv 外的脚本生成）
_*.pid
backend.tar.gz
frontend.tar.gz

# 运行时日志与 PID（manage.sh 生成，各自放在 backend/logs/ 与 frontend/logs/）
backend/logs/
frontend/logs/

# 运行时 TOML 配置（含 broker 明文密码，禁止入库；默认值见 flowerui-settings.toml）
flowerui.runtime.toml
backend/flowerui.runtime.toml

# 运行时「覆盖层」主题目录（启动时自动播种 base.css / _template.css，用户上传也落这里；
# 内置主题在 backend/flowerui/themes/ 仍随仓库分发，勿混）
backend/themes/

# 其它运行时/临时产物（审计数据、配置备份、Windows 误产物、工具状态）
*.jsonl
*.bak
nul
.agent-teams/
